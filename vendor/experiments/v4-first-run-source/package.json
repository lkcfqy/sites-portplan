{
  "name": "portplan-logisticsolver",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "Source-backed container pickup and empty-return planning research prototype",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/prepare-public.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:v2": "node scripts/benchmark-v2.mjs",
    "robustness:v2": "node scripts/robustness-v2.mjs",
    "public:gate": "python scripts/public-gate-validation-v3.py",
    "public:reproduce": "python scripts/reproduce-public-v3.py",
    "defense": "node scripts/build-defense.mjs"
  },
  "dependencies": {
    "glpk.js": "5.0.0"
  },
  "devDependencies": {
    "vite": "7.1.12"
  }
}
