  "generator": {
    "version": "v2-lcg-independent-cases",
    "random": "state=(1664525*state+1013904223) mod 2^32; draw=state/2^32, initial state=seed",
    "sharedDrawOrder": [
      "sizeFt:40 if draw<0.45 else20",
      "unloadDays:1 if draw<0.70;2 if draw<0.95;else3",
      "mechanism-specific draws",
      "discharge hour:07 if draw<0.5 else10"
    ],
    "aged-backlog": {
      "dischargeDay": "-(3+floor(draw*14))",
      "releaseDay": "floor(draw*4)",
      "dueDay": "min(12,releaseDay+unloadDays-1+3+floor(draw*5))"
    },
    "new-arrivals": {
      "releaseDay": "floor(draw*9)",
      "dischargeDay": "releaseDay-(draw<0.75?0:1)",
      "dueDay": "min(12,releaseDay+unloadDays-1+2+floor(draw*4))"
    },
    "batch-release": {
      "releaseDay": "[0,4,7][floor(draw*3)]",
      "dischargeDay": "releaseDay-(2+floor(draw*5))",
      "dueDay": "min(12,releaseDay+unloadDays-1+2+floor(draw*4))"
    },
    "capacityProfiles": {
      "balanced": [
        "ceil(n/4) truck movements/day",
        "ceil(n/5) unloading slots/day",
        "ceil(n/2) staging containers/day"
      ],
      "tight": [
        "ceil(n/6) truck movements/day",
        "ceil(n/8) unloading slots/day",
        "ceil(n/4) staging containers/day"
      ]
    },
    "independence": "Each main case uses a unique seed. No order-list nesting or reuse across the 48 cases. This does not make synthetic configurations a representative population sample."
  },
  "policies": [
    "fifo",
    "earliestFreeEnd",
    "marginalCost",
    "earliestDeadline",
    "strongSearch",
    "optimized"
  ],
  "budgets": {
    "milpTimeLimitSeconds": 2,
    "strongSearch": {
      "restartCount": 12,
      "iterations": 80,
      "seed": "scenario.seed"
    },
    "fairness": "All methods see the identical full-horizon inputs. Search uses fixed attempt counts; MILP has a solver time limit. CPU budgets are not equal. Report actual wall-clock time per policy, inclusive of calls; optimized wall-clock includes lazy initialization on first use."
  },
