  "caseCount": 480,
  "methods": [
    "baselineSerialSGS",
    "iteratedSGS"
  ],
  "methodDefinitions": {
    "baselineSerialSGS": "One serial schedule-generation pass, fixed stable Kahn topological priority by ascending original source job ID.",
    "iteratedSGS": "Same initial SGS, at most 256 segment removal/random insertion moves, 8 positive-duration jobs removed per segment, topological reinsertion, makespan hill climbing accepting ties. Inspired by MIT ALNS example; no adaptive roulette/mobile/non-peak/right-left justification/complete original ALNS."
  },
  "parameters": {
    "maxIterations": 256,
    "removeCount": 8,
    "auditReserveMs": 2
  },
  "seedBase": 97001,
  "seedRule": "97001 + zero-based canonical case index; same seed supplied to both policies (baseline deterministic). LCG state=(1664525*state+1013904223) mod2^32.",
  "budget": {
    "perMethodWarmMs": 100,
    "type": "in-process cooperative wall clock",
    "includes": "Caller clock before method invocation through complete in-process return: initial SGS, destroy/repair, schedule generation, every in-method event-sweep candidate audit and result construction. Late final returns are not timely complete schedules; audit-confirmed candidates retained separately.",
    "excludes": "Downloads, decompression, per-instance parsing, reference joins, module imports and a post-call evaluator recheck of the already-audited final schedule are shared outside method timer. No parent-enforced per-call interruption or cold-start equality claim.",
    "methodOrder": "Rotate two methods by canonical case index modulo2, one call at a time. No unrelated CPU workload during formal run."
  },
  "referenceUse": "Official OPT makespans must agree with official merged metadata. They score outputs only and are never passed into heuristic search/acceptance/stopping.",
  "model": "Single-mode nonpreemptive activities, original constant four renewable capacities/demand vectors, finish-to-start precedence, source project release and source horizon. Abstract original ticks; project due/tardiness fields retained but ignored by original RCPSP makespan objective, never imported as port hard deadlines.",
  "methodSource": {
    "repository": "https://github.com/N-Wouda/ALNS",
    "commit": "5ef1fd1171e6be49c947cd3e56e485509b9c1d64",
