  ],
  "analysisRules": [
    "Retain all480cases and both methods, null failures/late returns and all candidate schedules.",
    "Report completion, event-sweep validity, exact matches and gaps against official makespan optimum; references are not timing baselines.",
    "Paired method changes only both-complete cases, disclose missing/zero/adverse cases.",
    "No monetary fee, vehicle/fleet/shift, port event or PortPlan model conversion.",
    "Protocol and source snapshot before first method comparison. No tuning or case substitution after first formal run."
  ],
  "limitations": [
    "PSPLIB instances are ProGen-generated public known benchmarks, not actual logistics orders or a new private holdout.",
    "Resource vectors/precedence check a generic subproblem; PortPlan pickup/return truck endpoints and variable p-to-r staging occupancy are absent.",
    "No claimed comparison with full original ALNS, SOTA, real business savings or first-place probability.",
    "Public numeric files are permitted for research evaluation, explicit redistribution license not established; retain download-on-demand URL/SHA, not raw website ZIPs."
  ]
